[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[user]
	name = Jishnu Teegala
	email = 134275562+jishnuteegala@users.noreply.github.com
	signingkey = 7400A6FC6A1AF353
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Loaded last so a machine can override anything above (different signingkey,
# no gpgsign, different credential helper) without editing this repo file.
# Example ~/.gitconfig.local:
#   [user]
#   	signingkey = <machine-specific key id>
[include]
	path = ~/.gitconfig.local
